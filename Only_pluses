#include <bits/stdc++.h>

using namespace std;

int solve(int a, int b, int c) {
    
    for (int i = 0; i < 5; ++i) {
        
        if (a <= b && a <= c) {
            a++;
        } else if (b <= a && b <= c) {
            b++;
        } else {
            c++;
        }
    }
    return a * b * c;
}

int main() {
    int t;
    if (cin >> t) {
        while (t--) {
            int a, b, c;
            cin >> a >> b >> c;
            cout << solve(a, b, c) <<endl;
        }
    }
    
    return 0;
}